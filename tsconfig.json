{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "strictBuiltinIteratorReturn": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out", "test", "vitest.config.ts", "**/*.test.ts"]
}
